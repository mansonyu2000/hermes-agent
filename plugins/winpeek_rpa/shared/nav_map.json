{
  "_meta": {
    "version": "1.0",
    "description": "微信桌面版导航地图 — 声明式页面结构。地图是理论，位置记忆是经验。",
    "last_updated": "2026-06-16"
  },

  "pages": {
    "wechat_main": {
      "name": "微信",
      "nav_button": "微信",
      "nav_button_index": 0,
      "verify": {
        "uia": { "automation_id": "session_list" },
        "fingerprint_text": ["微信", "聊天", "会话"],
        "coordinate_hint": { "xPct": 0.055, "yPct": 0.12 }
      },
      "enter_actions": [
        { "type": "click_nav", "target": "微信" }
      ],
      "exit_actions": [],
      "description": "主聊天列表页，左侧导航栏第一个。含 session_list 虚拟列表。"
    },

    "contacts_main": {
      "name": "通讯录",
      "nav_button": "通讯录",
      "nav_button_index": 1,
      "verify": {
        "uia": { "automation_id": "primary_table_.contact_list" },
        "fingerprint_text": ["通讯录", "新的朋友", "群聊", "公众号", "联系人"],
        "coordinate_hint": { "xPct": 0.3, "yPct": 0.15 }
      },
      "enter_actions": [
        { "type": "click_nav", "target": "通讯录" }
      ],
      "exit_actions": [
        { "type": "click_nav", "target": "微信" }
      ],
      "description": "通讯录页，含多个可折叠分组(CellGroupView)。分组名前缀可能带数字后缀(如'群聊180')。"
    },

