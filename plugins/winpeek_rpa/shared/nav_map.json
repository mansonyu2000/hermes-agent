  "contacts_sub_pages": {
    "new_friend_page": {
      "name": "新的朋友",
      "parent_page": "contacts_main",
      "verify": {
        "uia": null,
        "fingerprint_text": ["新的朋友", "添加手机联系人"],
        "coordinate_hint": null
      },
      "enter_actions": [
        { "type": "click_group", "name": "新的朋友", "warning": "点击会跳页离开通讯录列表" }
      ],
      "exit_actions": [
        { "type": "click_nav", "target": "通讯录" }
      ],
      "skip_in_batch": true,
      "contact_type": "new_friend",
      "description": "点击'新的朋友'分组会跳转到添加朋友子页面，离开通讯录。批量采集必须跳过此分组。"
    },

    "my_enterprise_page": {
      "name": "我的企业",
      "parent_page": "contacts_main",
      "verify": {
        "uia": null,
        "fingerprint_text": ["我的企业", "管理员"],
        "coordinate_hint": null
      },
      "enter_actions": [
        { "type": "click_group", "name": "我的企业", "warning": "点击会跳页离开通讯录列表" }
      ],
      "exit_actions": [
        { "type": "click_nav", "target": "通讯录" }
      ],
      "skip_in_batch": true,
      "contact_type": "enterprise",
      "description": "点击'我的企业'分组会跳转到企业页面，离开通讯录。批量采集必须跳过。"
    }
  },

  "contacts_groups": {
    "新的朋友": {
      "contact_type": "new_friend",
      "skip_in_batch": true,
      "is_sub_page": true,
      "sub_page_id": "new_friend_page",
      "class_name": "CellGroupView",
      "name_match": "startswith"
    },
    "企业微信联系人": {
      "contact_type": "enterprise_wechat",
      "skip_in_batch": false,
      "is_sub_page": false,
      "class_name": "CellGroupView",
      "name_match": "startswith"
    },
    "我的企业": {
      "contact_type": "enterprise",
      "skip_in_batch": true,
      "is_sub_page": true,
      "sub_page_id": "my_enterprise_page",
      "class_name": "CellGroupView",
      "name_match": "startswith"
    },
    "群聊": {
      "contact_type": "group",
      "skip_in_batch": false,
      "is_sub_page": false,
      "class_name": "CellGroupView",
      "name_match": "startswith"
    },
    "公众号": {
      "contact_type": "official_account",
      "skip_in_batch": false,
      "is_sub_page": false,
      "class_name": "CellGroupView",
      "name_match": "startswith"
    },
    "服务号": {
      "contact_type": "service_account",
      "skip_in_batch": false,
      "is_sub_page": false,
      "class_name": "CellGroupView",
      "name_match": "startswith"
    },
    "联系人": {
      "contact_type": "friend",
      "skip_in_batch": false,
      "is_sub_page": false,
      "class_name": "CellGroupView",
      "name_match": "startswith"
    },
    "企业": {
      "contact_type": "enterprise",
      "skip_in_batch": false,
      "is_sub_page": false,
      "class_name": "CellGroupView",
      "name_match": "startswith",
      "note": "'企业'是'企业微信联系人'和'我的企业'的简称，可能在旧版本中出现"
    }
  },

  "detection_tiers": {
    "description": "get_current_page() 多层检测策略，从快到慢",
    "tiers": [
      { "name": "UIA", "method": "check_automation_id", "timeout_ms": 500 },
      { "name": "coordinate", "method": "check_coordinate_match", "timeout_ms": 300 },
      { "name": "OCR", "method": "check_ocr_fingerprint", "timeout_ms": 3000 }
    ]
  },

  "key_elements": {
    "nav_tabbar": {
      "automation_id": "MainView.main_tabbar",
      "description": "左侧导航栏容器，子元素为各页面按钮"
    },
    "session_list": {
      "automation_id": "session_list",
      "description": "微信主页的会话列表（虚拟列表），每个子元素 automationId 以 session_item_ 开头"
    },
    "contact_list": {
      "automation_id": "primary_table_.contact_list",
      "description": "通讯录页的联系人列表（虚拟列表），含 CellGroupView 分组头和联系人条目"
    },
    "chat_name_label": {
      "automation_id": "content_view.top_content_view.title_h_view.left_v_view.left_content_v_view.left_ui_.big_title_line_h_view.current_chat_name_label",
      "description": "聊天窗口顶部当前联系人名称"
    },
    "chat_input": {
      "automation_id": "chat_input_field",
      "description": "聊天消息输入框"
    },
    "msg_list": {
      "automation_id": "chat_message_list",
      "description": "聊天消息列表（虚拟列表）"
    },
    "search_list": {
      "automation_id": "search_list",
      "description": "Ctrl+F 搜索弹窗中的联系人列表"
    }
  }
